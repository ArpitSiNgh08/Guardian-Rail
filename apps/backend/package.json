    "issuer:issue": "tsx src/issuer/cli.ts issue"
  },
  "dependencies": {
    "@noble/curves": "latest",
    "cors": "^2.8.6",
    "express": "latest",
    "graphql-request": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/node": "^26.4.0",
    "tsx": "latest",
    "typescript": "^5.7.3"
  }
}
