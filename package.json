{
  "name": "guardian-rail",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-preserving ZK age and consent gate for AI chat applications.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@guardian-rail/frontend",
    "dev:backend": "npm run dev --workspace=@guardian-rail/middleware",
    "env:up": "docker compose --env-file infra/.env.example -f infra/docker-compose.yml up -d",
    "env:down": "docker compose -f infra/docker-compose.yml down",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "$@midnight-ntwrk/ledger-v8"
  }
}
